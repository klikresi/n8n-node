{
	"compilerOptions": {
		"target": "ES2022",
		"module": "CommonJS",
		"moduleResolution": "Node",
		"lib": ["ES2022"],
		"declaration": true,
		"strict": true,
		"noImplicitOverride": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"outDir": "dist",
		"rootDir": ".",
		"sourceMap": true
	},
	"include": ["nodes/**/*.ts", "credentials/**/*.ts", "api/**/*.ts"]
}
